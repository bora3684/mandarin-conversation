{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mao",
  "compatibility_date": "2026-09-24",
  "main": "./worker/index.ts",
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
